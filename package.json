{
  "name": "cuadro",
  "version": "0.3.0",
  "description": "Make videos in code with spark: a frame signal, a page, Chromium and ffmpeg",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./theme": {
      "types": "./src/theme.d.ts",
      "default": "./src/theme.js"
    },
    "./scenes": {
      "types": "./src/scenes.d.ts",
      "default": "./src/scenes.js"
    },
    "./level": {
      "types": "./src/level.d.ts",
      "default": "./src/level.js"
    },
    "./script": {
      "types": "./src/script.d.ts",
      "default": "./src/script.js"
    },
    "./player": {
      "types": "./src/player.d.ts",
      "default": "./src/player.js"
    },
    "./render": {
      "types": "./src/render.d.ts",
      "default": "./src/render.js"
    },
    "./voice": {
      "types": "./src/voice.d.ts",
      "default": "./src/voice.js"
    },
    "./make": {
      "types": "./src/make.d.ts",
      "default": "./src/make.js"
    }
  },
  "bin": {
    "cuadro": "bin/cuadro.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "node demo/music.js out/music.wav && node bin/cuadro.js render demo/index.html out/demo.mp4 --audio out/music.wav",
    "gif": "ffmpeg -v error -y -i out/demo.mp4 -vf \"fps=15,scale=480:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=128[p];[b][p]paletteuse=dither=bayer\" doc/img/demo.gif",
    "types": "npx -y -p typescript@5.9.3 tsc --noEmit --strict --target es2022 --module nodenext --lib es2022,dom test/types.ts"
  },
  "license": "ISC",
  "dependencies": {
    "playwright-core": "1.56.0",
    "spark": "github:ldiaz94/spark#v0.1.1"
  }
}
